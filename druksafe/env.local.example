# Open-Meteo works without keys. Override only if you proxy the APIs.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_TIMEOUT_MS=8000

# Twilio sender credentials. Keep real values only in .env.local.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Prototype receiver. Bhutan 8-digit numbers are normalized to +975.
ALERT_PHONE_NUMBER=77459910
